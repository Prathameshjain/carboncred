# =========================================
# Frontend (Vite/React) .gitignore
# =========================================

# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
build/
.next/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Vite
*.local
vite.config.ts.timestamp-*

# Cache
.cache/
.parcel-cache/
.eslintcache

# Storybook
storybook-static/

# Bundle analysis
stats.html
.webpack-stats.json
