# =========================================
# CarbonCred — Docker Environment Template
# =========================================
# Copy this file to .env before running docker compose
# Usage: cp .env.docker .env
# Then:  docker compose up --build -d

# -----------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Postgre123
POSTGRES_DB=carboncred
# NOTE: In Docker, host is the service name "db" — set automatically in docker-compose.yml

# -----------------------------------------
# Django Configuration
# -----------------------------------------
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-real-secret-key-in-production
DJANGO_DEBUG=False

# -----------------------------------------
# Blockchain Configuration (Sepolia Testnet)
# -----------------------------------------
# Get Alchemy API key from: https://www.alchemy.com/
ALCHEMY_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# WARNING: Never share your private key!
BLOCKCHAIN_PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY

# Deployed contract address (set after deployment)
CONTRACT_ADDRESS=YOUR_DEPLOYED_CONTRACT_ADDRESS

# Sepolia Chain ID
BLOCKCHAIN_CHAIN_ID=11155111
