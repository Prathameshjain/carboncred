# =========================================
# CarbonCred - Environment Variables
# =========================================
# Copy this file to .env and update the values

# -----------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=carboncred
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# -----------------------------------------
# Django Configuration
# -----------------------------------------
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------
# Blockchain Configuration (Sepolia Testnet)
# -----------------------------------------
# Get Alchemy API key from: https://www.alchemy.com/
ALCHEMY_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private key for contract deployment (Account 1 - BEE Admin)
# WARNING: Never commit real private keys!
BLOCKCHAIN_PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY

# Deployed contract address (set after deployment)
CONTRACT_ADDRESS=YOUR_DEPLOYED_CONTRACT_ADDRESS

# Sepolia Chain ID
BLOCKCHAIN_CHAIN_ID=11155111

# -----------------------------------------
# Frontend Configuration (optional)
# -----------------------------------------
REACT_APP_API_URL=http://127.0.0.1:8000
REACT_APP_CONTRACT_ADDRESS=YOUR_DEPLOYED_CONTRACT_ADDRESS
REACT_APP_SEPOLIA_CHAIN_ID=11155111
